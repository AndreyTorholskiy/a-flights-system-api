<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="publishMessageToQueue" doc:id="b2d62634-7363-4732-bf97-8a56ae6758b0" >
		<ee:transform doc:name="Logger Message: Flow Start" doc:id="22c827d2-2251-4e63-8c65-6d5044d41d10">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="logMessage"><![CDATA[%dw 2.0
output application/json
---
{
	message: "Publish message to the queue request"
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="auditLogging" doc:id="7c4d94cd-b563-47b3-b54b-281bd2390bd9" name="auditLogging" />
		<amqp:publish doc:name="Publish" doc:id="cdedbc33-1ab2-449e-b7bd-a856898fc6ce" config-ref="Local_RabbitMQ_AMQP_Config">
			<amqp:routing-keys>
				<amqp:routing-key value="hello" />
			</amqp:routing-keys>
		</amqp:publish>
		<ee:transform doc:name="Logger Message: Publish MQ Response" doc:id="20426ad9-c277-483a-9600-366db5f6a1bc" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{	
	status: "Message was successfully published",
	(sentMessage: payload) if (!isEmpty(payload))
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="logMessage" ><![CDATA[%dw 2.0
output application/json
---
{
	(sentMessage: payload) if (!isEmpty(payload))
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
	<sub-flow name="getMessageFromQueue" doc:id="1ef43832-7ff4-4a99-859e-449d5d7c99d2" >
		<ee:transform doc:name="Logger Message: Flow Start" doc:id="df1b0b9b-0ce9-4b0e-9774-402c9a578478">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="logMessage"><![CDATA[%dw 2.0
output application/json
---
{
	message: "Consume message from the queue request"
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="auditLogging" doc:id="16c5634c-d06f-42e3-8be2-0768572d8880" name="auditLogging" />
		<amqp:consume doc:name="Consume" doc:id="2b77b8c6-03af-4158-9298-c9aebb86275e" queueName="hello" config-ref="Local_RabbitMQ_AMQP_Config"/>
		<ee:transform doc:name="Logger Message: Consume MQ Response" doc:id="4c0d34e2-2e3a-4765-bcf5-b6108c51bd22" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{	
	status: "Message was successfully received",
	(recvMessage: payload) if (!isEmpty(payload))
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="logMessage" ><![CDATA[%dw 2.0
output application/json
---
{
	(retrieveMessage: payload) if (!isEmpty(payload))
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
